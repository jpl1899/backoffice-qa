{
  "info": {
    "_postman_id": "11c37611-e0c8-47e9-8a08-ef0b6daaa739",
    "name": "Backoffice-QA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "10733421"
  },
  "item": [
    {
      "name": "Login TCs",
      "item": [
        {
          "name": "Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"Error code is invalid_credentials\", function () {\r\n  const body = pm.response.json();\r\n  pm.expect(body.error_code).to.eql(\"invalid_credentials\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey"
            },
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apikey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"noexiste@test.com\",\r\n \"password\": \"mala123\" }\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
              "host": [
                "{{supabaseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Missing API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Missing API key\", function () {\r\n  const body = pm.response.json();\r\n    pm.expect(body.message).to.eql(\"No API key found in request\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"noexiste@test.com\",\r\n \"password\": \"mala123\" }\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
              "host": [
                "{{supabaseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
