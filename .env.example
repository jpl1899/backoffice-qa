# URL del ambiente contra el que corren los tests (staging de BackOffice en Render).
# Copiar a .env y completar. NUNCA commitear .env con valores reales.
WEB_URL=https://backoffice-1-za5e.onrender.com

# Identidad admin (whitelisted en ADMIN_EMAILS) — usada en el escenario positivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Usuario de prueba dedicado, NO admin — creado a mano en Supabase Auth
# (Dashboard -> Authentication -> Users -> Add user), solo para este escenario negativo.
# Nunca reusar una cuenta real de contador.
QA_NON_ADMIN_EMAIL=
QA_NON_ADMIN_PASSWORD=
